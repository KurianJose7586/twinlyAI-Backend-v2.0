# TwinlyAI Backend - Local Development Environment Variables
# Copy this file to .env and fill in the values

# ============================================================
# DATABASE
# ============================================================
# For local development with Docker Compose:
MONGO_CONNECTION_STRING=mongodb://localhost:27017/twinlyai_db
# For MongoDB Atlas production:
# MONGO_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/twinlyai_db

MONGO_DB_NAME=twinlyai_db

# ============================================================
# SECURITY & AUTHENTICATION
# ============================================================
# Generate strong secrets (min 32 characters) for production
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
SESSION_SECRET_KEY=dev-session-secret-change-in-production-min-32-chars
ALGORITHM=HS256

# Fernet encryption key (generated key for token encryption)
ENCRYPTION_KEY=eKqVwU8_Q8o-J_j9Q1IItx02yP1TqI4-M0Z3zUo9t6s=

# ============================================================
# AI & LLM SERVICES
# ============================================================
# Get GROQ API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get HuggingFace token from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token_here

# ============================================================
# GITHUB OAUTH
# ============================================================
# These are provided for development/testing only
# For production, create your own GitHub OAuth app:
# https://github.com/settings/developers
GITHUB_CLIENT_ID=Ov23liV01hQhbR6C5Bkq
GITHUB_CLIENT_SECRET=4cedb703dc9c1a4f057317effd3e9eb6af46e52c

# ============================================================
# GOOGLE OAUTH (Optional)
# ============================================================
# Get credentials from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================
# VECTOR DATABASE (Qdrant)
# ============================================================
# For local development with Docker Compose:
QDRANT_URL=http://localhost:6333
# For Qdrant Cloud:
# QDRANT_URL=https://your-cluster-name.qdrant.io

QDRANT_API_KEY=test-key

# ============================================================
# BACKGROUND JOBS (Celery + Redis)
# ============================================================
# For local development with Docker Compose:
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set to false to run connector sync inline (no Redis/Celery required)
USE_CELERY=false

# For Redis Cloud:
# CELERY_BROKER_URL=redis://default:password@redis-host:port
# CELERY_RESULT_BACKEND=redis://default:password@redis-host:port

# ============================================================
# FRONTEND URL
# ============================================================
# For local development:
FRONTEND_URL=http://localhost:3000
# For production:
# FRONTEND_URL=https://your-frontend-domain.vercel.app

# ============================================================
# CLOUD STORAGE (Cloudinary)
# ============================================================
# Optional - Get from: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_TYPE=local

# ============================================================
# REAL-TIME COMMUNICATION (Agora)
# ============================================================
# Optional - Get from: https://console.agora.io/
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ============================================================
# ENVIRONMENT
# ============================================================
# Options: dev, prod
ENV=dev

# ============================================================
# NOTES
# ============================================================
# 1. Never commit this file with real secrets to Git
# 2. For production, use Railway/Vercel environment variable management
# 3. For local development, create .env file: cp .env.example .env
# 4. Keep separate .env files for dev, staging, and production
# 5. Rotate secrets regularly in production
